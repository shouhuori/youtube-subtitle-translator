{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "YouTube Subtitle Translator, Transcript & Summary",
  "short_name": "YT Subtitles",
  "version": "0.1.0",
  "description": "Translate YouTube subtitles, read video transcripts, and generate AI summaries. Uses your LingRead account.",
  "permissions": ["storage", "tabs", "scripting", "webNavigation", "alarms"],
  "host_permissions": [
    "http://localhost:3100/*", "http://localhost:4100/*",
    "http://127.0.0.1:3100/*", "http://127.0.0.1:4100/*",
    "https://lingread.app/*",
    "*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "onboarding.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"],
      "js": ["content-youtube-bridge.js"],
      "world": "MAIN", "run_at": "document_start", "all_frames": true
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"],
      "js": ["config.js", "languages.js", "messages.js", "content-youtube.js", "content-youtube-subtitles.js"],
      "run_at": "document_end", "all_frames": true
    },
    {
      "matches": ["https://lingread.app/login*", "http://localhost:3100/login*"],
      "js": ["config.js", "content-auth.js"], "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube 字幕翻译、视频转写与总结",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{
    "resources": ["icons/icon48.png"],
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://www.youtube-nocookie.com/*"]
  }],
  "homepage_url": "https://lingread.app",
  "author": "LingRead"
}
